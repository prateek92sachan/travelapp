# Copy this file to .env and fill in your real keys
# .env is gitignored - never commit actual keys

VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here
VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here
VITE_OPENWEATHER_KEY=your_openweather_key_here
VITE_GEMINI_KEY=your_gemini_api_key_here
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
# App Check reCAPTCHA v3 site key (public; safe in client). Leave empty to disable.
VITE_FIREBASE_APPCHECK_SITE_KEY=your_recaptcha_v3_site_key_here
